NODE_ENV=production
PORT=8081

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ai_app
PGPASSWORD=
PGDATABASE=mkd_sku_ai
PGSSLMODE=verify-full
PGSSLROOTCERT=/run/secrets/rds-ca.pem
READ_QUERY_TIMEOUT_MS=15000

# Optional date anchor for controlled replay or stale upstream data windows.
# Leave empty for normal production use.
DATA_ANCHOR_DATE=
VITE_DATA_ANCHOR_DATE=

SESSION_SECRET=
COOKIE_SECURE=true

MKD_CORE_SOCKET=/run/mkd-core/core.sock
MKD_CORE_TIMEOUT_MS=190000
